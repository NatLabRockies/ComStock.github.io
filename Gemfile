source 'https://rubygems.org'

gem "jekyll", "~> 4.3" # installed by `gem jekyll`
# gem "webrick"        # required when using Ruby >= 3 and Jekyll <= 4.2.2

gem "just-the-docs", "0.4.1" # pinned to the current release
# gem "just-the-docs"        # always download the latest release

# GitHub Pages loads these automatically for `remote_theme` sites; a local
# `bundle exec jekyll serve` needs them listed here to render the theme.
group :jekyll_plugins do
  gem "jekyll-remote-theme", "0.4.3" # same version the github-pages gem pins
  gem "jekyll-include-cache"
end
